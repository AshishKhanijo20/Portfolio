# Copy to backend/.env for local development. Never commit .env.

ENVIRONMENT=development
# Docker Postgres from docker-compose.yml (host port 5433)
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@localhost:5433/portfolio
CORS_ORIGINS=http://localhost:3000

# Contact alerts - leave RESEND_API_KEY empty to print emails to the console
RESEND_API_KEY=
ALERT_EMAIL_TO=askhanijo20@gmail.com
ALERT_EMAIL_FROM=Portfolio <onboarding@resend.dev>

# Spam protection
RATE_LIMIT_PER_HOUR=5
IP_HASH_SALT=change-me-to-a-long-random-string
# true only when deployed behind Render/Fly's proxy
TRUST_PROXY_HEADERS=false
